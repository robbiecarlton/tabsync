# Postgres connection string. Leave unset to use file-backed PGlite at PGLITE_DIR.
# DATABASE_URL=postgres://user:pass@localhost:5432/tabsync
PGLITE_DIR=./.data/pglite
PORT=8787
# Comma-separated origins allowed by CORS. Not needed for the extension when its manifest grants
# host permission for this server; needed if the extension talks to a URL it lacks permission for.
# ALLOWED_ORIGINS=chrome-extension://<extension-id>
# Behind Railway's proxy: trust X-Forwarded-For/-Proto, and refuse plain HTTP.
# TRUST_PROXY=1
# REQUIRE_HTTPS=1
